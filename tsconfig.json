{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "lib": [
      "DOM",
      "ES5"
    ],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "typeRoots": ["node_modules/@types", "types"],
    "jsx": "react-jsx",
    "importHelpers": true
  },
  "include": ["src", "types", "config"],
  "exclude": [
    "node_modules"
  ]
}
